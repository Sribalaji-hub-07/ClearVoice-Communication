# ─────────────────────────────────────────────────────────────
# ClearVoice — Environment Variables
#
# Copy this file to .env for local development.
# In Railway, add these as Environment Variables in your project.
# ─────────────────────────────────────────────────────────────

# ── Frontend: Signaling Server URL ───────────────────────────
# Leave blank in production — the app auto-connects to the same
# Railway host. Only set this for a separate local dev server.
VITE_SIGNALING_URL=

# ── Optional: EmailJS (real OTP emails) ──────────────────────
# Sign up free at https://www.emailjs.com
# Without these, ClearVoice runs in Demo Mode (OTP in a toast)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Optional: TURN Server (relay for NAT traversal) ──────────
# Recommended for production. Get free TURN from:
#   - https://www.metered.ca/tools/openrelay  (free tier)
#   - https://numb.viagenie.ca               (free)
#   - Self-hosted coturn
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Server Port ───────────────────────────────────────────────
# Railway sets PORT automatically. Do not override in production.
# PORT=3001
