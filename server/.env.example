# Backend (Node.js signaling server) - reference list of the variables it reads.
# The process reads its environment directly; there is no dotenv loader, so this
# file is documentation. Set them in PowerShell ($env:NAME = "value"), in a
# startup script, or in Railway's Variables tab - or add dotenv if you want file loading.
# On Railway the secrets belong in the Variables tab, never committed.

# Port the server listens on. Railway injects PORT automatically; local dev uses 3001.
PORT=3001

# Comma-separated list of origins allowed to open a signaling socket.
# Use the exact scheme + host + port of the frontend.
CORS_ORIGIN=http://localhost:5173

# --- ICE / STUN / TURN -------------------------------------------------------
# STUN alone works when at least one peer is reachable directly or through a
# reflexive candidate. Symmetric-NAT pairs (two routers with NAT, mobile
# networks, some campus networks) need a TURN relay.
STUN_URL=stun:stun.l.google.com:19302
STUN_URL_2=

# Never commit real TURN credentials. Supply them only through the environment.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
