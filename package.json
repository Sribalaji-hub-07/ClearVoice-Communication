{
  "name": "clearvoice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-Time Adaptive Noise Suppression for Enhanced IP Voice Communication",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "install:server": "npm --prefix server ci",
    "typecheck": "tsc --noEmit",
    "test:dsp": "node tools/dsp-selftest.mjs",
    "test:signaling": "node tools/signaling-test.mjs",
    "test": "node tools/dsp-selftest.mjs && node tools/signaling-test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
